@namespace Quantum.Zju.Plugin.Cas.UI.Pages
@using Microsoft.AspNetCore.Components.Web
<section aria-busy="@_busy">
    <div class="section-heading">
        @if (_account.IsSignedIn)
        {
            <div class="plugin-meta">
                <strong>@_account.Username</strong>
            </div>
        }
        <div class="plugin-actions">
            @if (_account.IsSignedIn)
            {
                <button type="button" class="secondary-button" @onclick="SignOutAsync" disabled="@_busy">@Text("Sign out", "退出")</button>
            }
            else
            {
                <button type="button" class="primary-button" @onclick="SignInAsync" disabled="@_busy">@Text("Sign in", "登录")</button>
            }
        </div>
    </div>
    @if (!string.IsNullOrEmpty(_error))
    {
        <p role="alert">@_error</p>
    }
</section>
